{
  "name": "k-mathews.com",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "containerEnv": { "JEKYLL_ENV": "production" },
  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": { "label": "Jekyll", "onAutoForward": "openBrowser" },
    "35729": { "label": "LiveReload", "onAutoForward": "silent" }
  },
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
  "postAttachCommand": "bundle exec jekyll serve --host 0.0.0.0 --livereload --config _config.yml,_config.dev.yml --destination /tmp/_site",
  "customizations": {
    "vscode": {
      "extensions": ["sissel.shopify-liquid", "redhat.vscode-yaml"]
    }
  }
}
